{
    /*
     * ======================================
     * SETTINGS (json5)
     * ======================================
     */



    /*
     * ======================================
     * TRANSLATION SERVICES 
     * ======================================
     * The following arrays determine the order and visibility of the 
     * corresponding controls (e.g. translator buttons) in the app's UI.
     *
     * Commenting out an item will hide it from UI
     *
     * ⚠️ Caution: Any executable you link in the "command" field runs directly on your machine. 
     * Be careful and only use CLI apps from sources you personally trust.
     *
     * ----------QTranslate Services----------
     * The "QTRANSLATE" value of the "command" field is reserved for QTranslate services.
     * To load QTranslate services, move the "Services" folder to .\extensions\qtranslate
     * Service folder names are used as uids - only letters, numbers, spaces, and underscores 
     * are allowed.
     * To disable a service when the "qtranslate_autoload" option is active, add any other character
     * to its folder name or delete the folder entirely.
     * To configure a service (and enable it when "qtranslate_autoload" is disabled),
     * add an object to the array following the "QTExample" template.
     * 
     * Setting the "command" or "dict_path" fields for items with the following uids will override 
     * their built-in services: 
     * - "tr_google"        - "dict_google"            - "prnn_wiki"
     * - "tr_google2"       - "dict_wiktionary_en"     - "prnn_google"
     * - "tr_deepl"
     *
     * The working directory of the sideprocess is always set to ".\extensions\{service_uid}\"
     *
     * The "uid" field can only contain alphabetical characters, spaces, digits and underscores
     *
     * Setting the "emulation" field tells the service to use wreq_cli.exe 
     * for browser TLS fingerprint emulation
     * --------------------------------------
     */ 

    "qtranslate_autoload": true,

    "translators": [
        {
            "uid": "tr_google",
            "name": "Google (old api)",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "tr_google2",
            "name": "Google",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "tr_deepl",
            "name": "DeepL",
            "emulation": "Chrome137",
            //"use_proxy": true
        },
        {
            "uid": "tr_bergamot",
            "name": "Bergamot",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "app.cjs"
            ],
            "reload_if_lang_changed": true
        },

        // --- EXAMPLES ---
        /*{
            "uid": "QTExample",
            "name": "QT example",
            "command": "QTRANSLATE",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },*/
        /*{
            "uid": "tr_js_example",
            "name": "JS example",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "index.cjs"
            ],
            "reload_if_lang_changed": false
        },*/
        /*{
            "uid": "tr_c_example",
            "name": "C example",
            "command": ".\\extensions\\tr_c_example\\app",
            "args": [
            ],
            "reload_if_lang_changed": false
        },*/

    ],



    /*
     * ======================================
     * DICTIONARY SERVICES 
     * ======================================
     */ 
    "dictionaries": [
        {
            "uid": "dict_google",
            "name": "Google",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "dict_wiktionary_en",
            "name": "English Wiktionary",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },

        // --- DSL(LINGVO) OFFLINE DICTIONARIES ---
        /*{
            "uid": "dict_example_dsl",
            "name": "Example dict",
            "dict_path": "dictionaries\\example.dsl"
        },*/
    ],



    /*
     * ======================================
     * TEXT TO SPEECH SERVICES 
     * ======================================
     */ 
    "tts_services": [
        {
            "uid": "tts_kokoro",
            "name": "Kokoro",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "--allow-ffi=.",
                "--allow-env",
                "--allow-write=.",
                "--allow-run=../../oggenc2",
                "index.mjs"
            ],
            "voices": ["af_heart", "af_nicole"]
        }
    ],



    /*
     * ======================================
     * PRONUNCIATION SERVICES 
     * ======================================
     */ 
    "prnn_services": [
        {
            "uid": "prnn_google",
            "name": "Google Pronunciations"
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "prnn_wiki",
            "name": "Wiktionary Pronunciations"
            //"emulation": "Chrome137",
            //"use_proxy": false
        }
    ],



    /*
     * ======================================
     * API KEYS 
     * ======================================
     * Default X-Goog-API-Key from: 
     * https://github.com/ssut/py-googletrans/issues/268#issuecomment-3220244991
     * --------------------------------------
     */ 
    "google_translate_api_key": "AIzaSyATBXajvzQLTDHEQbcpq0Ihe0vWDHmO520",
    


    /*
     * ======================================
     * PRONUNCIATIONS
     * ======================================
     * English accents to download
     * --------------------------------------
     */
    "eng_accents": [
        "us",
        "gb",
        "uk",
        //"in" //Indian?
    ],
    "download_all_pronunciations": false, //dowload pronunciation in all available accents and languages, if possible



    /*
     * ======================================
     * PROXY 
     * ======================================
     * url: <protocol>://<host>:port
     * Example: "socks5://example.com:8000"
     * supported protocols: "http", "https", "soks4", "soks4a", "soks5"
     */
    /*"proxy": {
        "url": "http://127.0.0.1:9080",
        //"username": "",
        //"password": ""
    },*/
    "use_proxy_global": false, //if true, individual use_proxy flags are ignored and all traffic goes through the proxy



    /*
     * ======================================
     * LANGUAGES 
     * ======================================
     * Allowed values: ISO 639_3, ISO 639_1 or "auto"
     * https://en.wikipedia.org/wiki/List_of_ISO_639_language_codes
     *
     * The first item is used as the default
     * --------------------------------------
     */
    "pinned_src_languages": ["auto", "en", "es", "zh", "ja", "ru"],
    "pinned_target_languages": ["ru", "en", "es"],
    "switch_target_lang": true, //IF source_language (auto-detected) == target_language THEN target_langage = first pinned source_language that is not 'auto'



    /*
     * ======================================
     * HOTKEYS 
     * ======================================
     * Key Codes: https://docs.rs/global-hotkey/0.8.0/global_hotkey/hotkey/enum.Code.html
     * --------------------------------------
     */
    "translate_hotkey": "ctrl+KeyQ", //"ctrl+KeyT",
    "dict_hotkey": "ctrl+shift+KeyQ", //"ctrl+KeyD",
    "ocr_hotkey": "ctrl+Backquote",
    "single_word_to_dict": true, //if the selected text contains one single word, send it to the dictionary



    /*
     * ======================================
     * UI
     * ======================================
     */
    "ui_lang": "en",
    "ui_font_size": 12,
    "text_font_size": 14,
    "win_bg_color": "#C0C0C0", //"#D6CFC6",
    "win_bg2_color": "#C0C0C0",
    "text_bg_color_popup": "#F0F0F0",
    "text_bg_color_main": "#FFFFFF",
    "popup_opacity": 1.0, //0.0-1.0
    "no_tooltips": false,
    


    /*
     * ======================================
     * TIMEOUTS 
     * ======================================
     */
    "ext_service_unload_timeout": 120, //in seconds
    "http_throttling": 1.5, //rate limit for online translation services, in seconds (float values allowed)
    "http_request_timeout": 30, //in seconds



    /*
     * ======================================
     * LIMITS 
     * ======================================
     */
    "source_text_max_length": 4500, //Source text will be truncated to this size. The recommend value is 5000 or less (google translate api limit).
    "source_text_min_length": 3,
    "dict_request_max_length": 100,
    "history_max_entries": -1, //marked as favorites is not included; set -1 to disable auto-clearing



    /*
     * ======================================
     * SOURCE TEXT PREPROCESSING
     * ======================================
     * regex for text preprocessing
     * comment out to disable
     * --------------------------------------
     */
    "re_str_find": "\\n(?=[a-z])", //default: "\\n(?=[a-z])" (removes line break if the next line starts with a lowercase letter)
    "re_str_replace": "",



    /*
     * ======================================
     * OCR 
     * ======================================
     * PP-OCRv6 small and medium support the official 50 v6 recognition languages: 
     * Simplified Chinese, Traditional Chinese, English, Japanese, and 46 Latin-script languages. 
     * PP-OCRv6 tiny follows the same set except Japanese.
     * 
     * Korean, Cyrillic, Arabic, Devanagari, Thai, Greek, Tamil, and Telugu should continue 
     * using the PP-OCRv5 script-specific recognition models.
     *
     * Download models: https://github.com/zibo-chen/rust-paddle-ocr/models
     * --------------------------------------
     */
    "ocr_fullscreen": true,
    "ocr_models": [
        {
            "name": "small",
            "det_model": "ocr_models/PP-OCRv6_small_det.mnn",
            "rec_model": "ocr_models/PP-OCRv6_small_rec.mnn",
            "charset":   "ocr_models/ppocr_keys_v6_small.txt"
        },
        /*{
            "name": "tiny (fast)",
            "det_model": "ocr_models/PP-OCRv6_tiny_det.mnn",
            "rec_model": "ocr_models/PP-OCRv6_tiny_rec.mnn",
            "charset":   "ocr_models/ppocr_keys_v6_tiny.txt"
        },*/
        /*{
            "name": "cyrillic", 
            "det_model": "ocr_models/PP-OCRv5_mobile_det.mnn",
            "rec_model": "ocr_models/cyrillic_PP-OCRv5_mobile_rec_infer.mnn",
            "charset":   "ocr_models/ppocr_keys_cyrillic.txt"
        },*/
    ],

}