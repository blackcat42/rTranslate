{

    //The following arrays determine the order and visibility of the corresponding controls (e.g. translator buttons) in the app's UI. Commenting out an item will hide it from UI.

    //⚠️ Caution: Any executable you link in the "command" field runs directly on your machine. Be careful and only use CLI apps from sources you personally trust.

    //WARN!: Setting the "command" field for items with the following uids will override their built-in services: tr_google, tr_google2, tr_deepl, dict_wiktionary_en, prnn_wiki, prnn_google

    //"uid" can only contain alphabetical characters, digits and underscores

    "translators": [
        {
            "uid": "tr_google",
            "name": "Google (old api)",
            //"use_proxy": false
        },
        {
            "uid": "tr_google2",
            "name": "Google",
            //"use_proxy": false
        },
        {
            "uid": "tr_deepl",
            "name": "DeepL",
            //"use_proxy": true
        },
        {
            "uid": "tr_bergamot",
            "name": "Bergamot",

            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "app.cjs"
            ],
            "reload_if_lang_changed": true
        },

        //EXAMPLES:
        /*{
            "uid": "tr_js_example",
            "name": "JS example",
            "command": "deno",

            //working directory of the sideprocess always sets as ".\extensions\{service_uid}\"
            "args": [
                "--allow-read=.",
                "--deny-net",
                "index.cjs"
            ],
            "reload_if_lang_changed": false
        },*/
        /*{
            "uid": "tr_c_example",
            "name": "C example",
            "command": ".\\extensions\\tr_c_example\\app",
            "args": [
            ],
            "reload_if_lang_changed": false
        },*/

    ],

    "dictionaries": [
        {
            "uid": "dict_google",
            "name": "Google",
        },
        {
            "uid": "dict_wiktionary_en",
            "name": "English Wiktionary",
        },

        //DSL(LINGVO) OFFLINE DICTIONARIES:
        /*{
            "uid": "dict_example_dsl",
            "name": "Example dict",
            "dict_path": "dictionaries\\example.dsl"
        },*/
    ],

    "tts_services": [
        {
            "uid": "tts_kokoro",
            "name": "Kokoro",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "--allow-ffi=.",
                "--allow-env",
                "--allow-write=.",
                "--allow-run=../../oggenc2",
                "index.mjs"
            ],
            "voices": ["af_heart", "af_nicole"]
        }
    ],

    "prnn_services": [
        {
            "uid": "prnn_google",
            "name": "Google Pronunciations"
        },
        {
            "uid": "prnn_wiki",
            "name": "Wiktionary Pronunciations"
        }
    ],


    //"google_translate_api_key": null, //X-Goog-API-Key 
    "google_translate_api_key": "AIzaSyATBXajvzQLTDHEQbcpq0Ihe0vWDHmO520", //https://github.com/ssut/py-googletrans/issues/268#issuecomment-3220244991
    
    //PRONUNCIATIONS: English accents to download
    "eng_accents": [
        "us",
        "gb",
        "uk",
        //"in" //Indian?
    ],
    "download_all_pronunciations": false, //dowload pronunciation in all available accents and languages, if possible


    /*"proxy": {
        "url": "http://127.0.0.1:9080", //supported protocols: "http", "https", "soks4", "soks4a", "soks5"
        //"username": "",
        //"password": ""
    },*/

    

    //ISO 639_3 or ISO 639_1 or "auto"; first item is used as the default
    "pinned_src_languages": ["auto", "en", "es", "zh", "ja", "ru"],
    "pinned_target_languages": ["ru", "en", "es"],
    "switch_target_lang": true, //IF target language == source language THEN target langage = first pinned src lang that is not 'auto'

    //HOTKEYS
    //Key Codes: https://docs.rs/global-hotkey/0.8.0/global_hotkey/hotkey/enum.Code.html
    "translate_hotkey": "ctrl+KeyQ", //"ctrl+KeyT",
    "dict_hotkey": "ctrl+shift+KeyQ", //"ctrl+KeyD",
    "ocr_hotkey": "ctrl+Backquote",
    "single_word_to_dict": true, //if selected text contains single word, send it to the dictionary

    "ui_font_size": 12,
    "text_font_size": 14,
    "win_bg_color": "#C0C0C0", //"#D6CFC6",
    "win_bg2_color": "#C0C0C0",
    "text_bg_color_popup": "#F0F0F0",
    "text_bg_color_main": "#FFFFFF",
    "popup_opacity": 1.0, //0.0-1.0

    "ext_service_unload_timeout": 120, //in seconds
    "http_throttling": 1.5, //rate limit for online translation services, in seconds (float values allowed)
    "http_request_timeout": 30, //in seconds

    "source_text_max_length": 4500, //Source text will be truncated to this size. The recommend value is 5000 or less (google translate api limit).

    //regex for text preprocessing
    //comment out to disable
    "re_str_find": "\\n(?=[a-z])", //default: "\\n(?=[a-z])"
    "re_str_replace": "",

    "transl_request_min_length": 3,
    "dict_request_max_length": 100,

    "ocr_fullscreen": true,
    
    "history_max_entries": -1, //marked as favorites is not included; set -1 to disable auto-clearing

    //sqlite is required for history support; default as true; disabling is not recommended
    //"use_db": true,
}