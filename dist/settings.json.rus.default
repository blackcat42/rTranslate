{
    /*
     * ======================================
     * НАСТРОЙКИ (json5)
     * ======================================
     */



    /*
     * ======================================
     * СЕРВИСЫ ПЕРЕВОДА
     * ======================================
     * Следующие массивы определяют порядок и видимость соотв. элементов управления 
     * в интерфейсе программы (в том числе кнопок с переводчиками). 
     *
     * Закомментируйте элемент, чтобы отключить соответствующий сервис.
     *
     * ⚠️ Предупреждение: Любой исполняемый файл, указанный в поле "command", исполняется 
     * вне какой-либо песочницы и имеет полный доступ к вашему устройству. 
     *
     * ----------Сервисы QTranslate----------
     * Значение "QTRANSLATE" поля "command" зарезервировано для сервисов QTranslate.
     * Для подгрузки сервисов QTranslate переместите папку Services в .\extensions\qtranslate
     * Имена папок с сервисами используются в качестве uid - разрешены только буквы, цифры, 
     * пробелы и нижние подчеркивания. Чтобы отключить сервис при активной опции "qtranslate_autoload"
     * можно добавить любой другой символ к имени папки, либо удалить её. 
     * Для настройки сервиса (и его активации при отключенном "qtranslate_autoload") добавьте 
     * элемент в массив, как в примере "QTExample".
     * --------------------------------------
     *
     * Заполнение полей "command" или "dict_path" для элементов со следующими uid, перезапишет
     * их встроенные сервисы: 
     * - "tr_google"        - "dict_google"            - "prnn_wiki"
     * - "tr_google2"       - "dict_wiktionary_en"     - "prnn_google"
     * - "tr_deepl"
     *
     * Рабочая директория сайдпроцесса, указанного в поле "command", всегда 
     * устанавливается как ".\extensions\{uid сервиса}\"
     *
     * Поле "uid" может содержать только буквы, цифры, пробелы и нижние подчеркивания (_)
     *
     * Заполнение поля "emulation" указывает сервису использовать wreq_cli.exe 
     * для эмуляции браузерного TLS отпечатка
     * --------------------------------------
     */ 

    "qtranslate_autoload": true,

    "translators": [
        {
            "uid": "tr_google",
            "name": "Google (old api)",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "tr_google2",
            "name": "Google",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "tr_deepl",
            "name": "DeepL",
            "emulation": "Chrome137",
            //"use_proxy": true
        },
        {
            "uid": "tr_bergamot",
            "name": "Bergamot",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "app.cjs"
            ],
            "reload_if_lang_changed": true
        },

        // --- EXAMPLES ---
        /*{
            "uid": "QTExample",
            "name": "QT example",
            "command": "QTRANSLATE",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },*/
        /*{
            "uid": "tr_js_example",
            "name": "JS example",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "index.cjs"
            ],
            "reload_if_lang_changed": false
        },*/
        /*{
            "uid": "tr_c_example",
            "name": "C example",
            "command": ".\\extensions\\tr_c_example\\app",
            "args": [
            ],
            "reload_if_lang_changed": false
        },*/

    ],



    /*
     * ======================================
     * СЛОВАРИ
     * ======================================
     */ 
    "dictionaries": [
        {
            "uid": "dict_google",
            "name": "Google",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "dict_wiktionary_en",
            "name": "English Wiktionary",
            //"emulation": "Chrome137",
            //"use_proxy": false
        },

        // --- ОФФЛАЙН СЛОВАРИ В ФОРМАТЕ DSL(LINGVO) ---
        /*{
            "uid": "dict_example_dsl",
            "name": "Example dict",
            "dict_path": "dictionaries\\example.dsl"
        },*/
    ],



    /*
     * ======================================
     * СЕРВИСЫ ОЗВУЧКИ ТЕКСТА 
     * ======================================
     */ 
    "tts_services": [
        {
            "uid": "tts_kokoro",
            "name": "Kokoro",
            "command": "deno",
            "args": [
                "--allow-read=.",
                "--deny-net",
                "--allow-ffi=.",
                "--allow-env",
                "--allow-write=.",
                "--allow-run=../../oggenc2",
                "index.mjs"
            ],
            "voices": ["af_heart", "af_nicole"]
        }
    ],



    /*
     * ======================================
     * СЕРВИСЫ ПРОИЗНОШЕНИЙ
     * ======================================
     */ 
    "prnn_services": [
        {
            "uid": "prnn_google",
            "name": "Google Pronunciations"
            //"emulation": "Chrome137",
            //"use_proxy": false
        },
        {
            "uid": "prnn_wiki",
            "name": "Wiktionary Pronunciations"
            //"emulation": "Chrome137",
            //"use_proxy": false
        }
    ],



    /*
     * ======================================
     * КЛЮЧИ API 
     * ======================================
     * Ключ X-Goog-API-Key взят отсюда: 
     * https://github.com/ssut/py-googletrans/issues/268#issuecomment-3220244991
     * --------------------------------------
     */ 
    "google_translate_api_key": "AIzaSyATBXajvzQLTDHEQbcpq0Ihe0vWDHmO520",
    


    /*
     * ======================================
     * ПРОИЗНОШЕНИЯ
     * ======================================
     * Скачивать произношения в следйющих англ. акцентах 
     * (код для британского английского в разных сервисах отличается)
     * --------------------------------------
     */
    "eng_accents": [
        "us",
        "gb",
        "uk",
        //"in" //Indian?
    ],
    "download_all_pronunciations": false, //dowload pronunciation in all available accents and languages, if possible



    /*
     * ======================================
     * ПРОКСИ 
     * ======================================
     * url: <protocol>://<host>:port
     * Пример: "socks5://example.com:8000"
     * поддерживаемые протоколы: "http", "https", "soks4", "soks4a", "soks5"
     */
    /*"proxy": {
        "url": "http://127.0.0.1:9080",
        //"username": "",
        //"password": ""
    },*/
    "use_proxy_global": false, //если true - флаги use_proxy игнорируются, все запросы идут через прокси


    /*
     * ======================================
     * ЯЗЫКИ 
     * ======================================
     * Допустимые значения: ISO 639_3, ISO 639_1 или "auto" (автоопределение)
     * https://en.wikipedia.org/wiki/List_of_ISO_639_language_codes
     *
     * Первый элемент в массиве устанавливается как язык по умолчанию (по умолчанию это "auto" и "ru",
     * т.е. автоматически определять язык и переводить на русский)
     * src (source) - исходный язык
     * target - язык, на который нужно переводить
     * --------------------------------------
     */
    "pinned_src_languages": ["auto", "en", "es", "zh", "ja", "ru"],
    "pinned_target_languages": ["ru", "en", "es"],
    "switch_target_lang": true, //ЕСЛИ язык источника (автоопределение) === целевой язык ТО целевой язык = первый закреплённый исходный язык, который не является 'auto' (по умолчанию это "en", то есть при попытке перевода русского текста на русский, он переведётся на английский)



    /*
     * ======================================
     * ГОРЯЧИЕ КЛАВИШИ 
     * ======================================
     * Key Codes: https://docs.rs/global-hotkey/0.8.0/global_hotkey/hotkey/enum.Code.html
     * --------------------------------------
     */
    "translate_hotkey": "ctrl+KeyQ", //"ctrl+KeyT",
    "dict_hotkey": "ctrl+shift+KeyQ", //"ctrl+KeyD",
    "ocr_hotkey": "ctrl+Backquote",
    "single_word_to_dict": true, //если выбранный текст содержит только одно слово - отправить его в словарь



    /*
     * ======================================
     * ИНТЕРФЕЙС (шрифты, цвета)
     * ======================================
     */
    "ui_font_size": 12,
    "text_font_size": 14,
    "win_bg_color": "#C0C0C0", //"#D6CFC6",
    "win_bg2_color": "#C0C0C0",
    "text_bg_color_popup": "#F0F0F0",
    "text_bg_color_main": "#FFFFFF",
    "popup_opacity": 1.0, //0.0-1.0



    /*
     * ======================================
     * ТАЙМАУТЫ 
     * ======================================
     */
    "ext_service_unload_timeout": 120, //в секундах
    "http_throttling": 1.5, //ограничение на повторные запросы к онлайн сервисам перевода, в секундах (допустимы дробные значения)
    "http_request_timeout": 30, //в секундах



    /*
     * ======================================
     * ЛИМИТЫ 
     * ======================================
     */
    "source_text_max_length": 4500, //Исходный текст обрезается до этого размера (в символах). Рекомендуемое значение: 5000 или меньше (ограничение апи google translate).
    "source_text_min_length": 3,
    "dict_request_max_length": 100,
    "history_max_entries": -1, //Максимальное кол-во записей в истории. Элементы, отмеченные как избранные, никогда не удаляются. Установите -1 чтобы полностью отключить очистку истории переводов



    /*
     * ======================================
     * ОБРАБОТКА ТЕКСТА ПЕРЕД ОТПРАВКОЙ НА ПЕРЕВОД
     * ======================================
     * регулярное выражение
     * закомментируйте чтобы отключить
     * пробелы в начале и конце текста удаляются в любом случае
     * --------------------------------------
     */
    "re_str_find": "\\n(?=[a-z])", //по умолчанию: "\\n(?=[a-z])" (удаляет разрыв строки, если следующая строка начинается со строчной буквы (если следующая строка пустая - не срабатывает))
    "re_str_replace": "",



    /*
     * ======================================
     * РАСПОЗНАВАНИЕ ТЕКСТА 
     * ======================================
     */
    "ocr_fullscreen": true,
    
}